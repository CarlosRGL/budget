# Copy to .env and fill in. See docs/self-hosting.md for every variable.

APP_NAME=Budget
# local for development, production on a server (with APP_DEBUG=false)
APP_ENV=local
# Generate with: php artisan key:generate. Never change it once in use
# (two-factor secrets are encrypted with it): keep it with your backups.
APP_KEY=
APP_DEBUG=true
# The public address, with https:// in production. The bank redirect URL
# is APP_URL/bank/callback.
APP_URL=http://localhost:8000
# Timezone of the budget months and of the scheduled bank syncs.
APP_TIMEZONE=Europe/Paris

# Default language (en, fr or es): for visitors not signed in whose browser
# language is not supported, and for the names the app stores in the
# household's data (payees it creates, memos). Each member picks their own
# interface language in their profile.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Use LOG_CHANNEL=stderr in Docker to read the logs with `docker logs`.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB or MySQL (production). For a quick local try with SQLite:
# DB_CONNECTION=sqlite, remove the other DB_* lines and create
# database/database.sqlite.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=budget
DB_USERNAME=root
DB_PASSWORD=

# Sessions, cache and queued jobs are stored in the database: nothing else
# to run besides the queue worker and the scheduler.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Not used by the app, Laravel defaults.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is used for invitations, password resets and email changes.
# With MAIL_MAILER=log, emails are written to the log instead of being sent
# (invitations can still be shared with "Copy link").
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Not used by the app, Laravel defaults.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bank sync with EnableBanking: see docs/enablebanking.md, or the
# "Set up bank sync" page of the app (Bank connections).
# The application ID (a UUID) from the EnableBanking Control Panel.
ENABLEBANKING_APP_ID=
# The application's private key, in one of two ways. Never commit it.
#  - a PEM file: by default storage/app/private/enablebanking.pem, or the
#    path below (absolute, or relative to the app);
# ENABLEBANKING_PRIVATE_KEY_PATH=storage/app/private/enablebanking.pem
#  - or the PEM content itself, base64-encoded, handy with Docker:
#    base64 < enablebanking.pem | tr -d '\n'
#    When set, it wins over the file.
ENABLEBANKING_PRIVATE_KEY=
ENABLEBANKING_BASE_URL=https://api.enablebanking.com
